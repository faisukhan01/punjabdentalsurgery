# ─────────────────────────────────────────────────────────────────────
# Punjab Dental Surgery — environment variables
#
# On Vercel, add these in:
#   Project → Settings → Environment Variables
# (add for Production AND Preview), then REDEPLOY.
# ─────────────────────────────────────────────────────────────────────

# Turso (libSQL) production database — REQUIRED in production.
# Dashboard: https://dashboard.turso.tech → your database
TURSO_DATABASE_URL=libsql://your-database-your-org.aws-ap-south-1.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-jwt

# Admin panel PIN — optional (defaults to "1234" when unset).
ADMIN_PIN=1234

# Local development only — NOT needed on Vercel.
# When TURSO_DATABASE_URL is absent the app falls back to this SQLite file.
# DATABASE_URL=file:./db/custom.db
